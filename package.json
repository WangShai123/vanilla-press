{
  "name": "vanilla-press-repo",
  "version": "1.3.2",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "node packages/vanilla-press/bin/vanilla-press.js build",
    "build:packages": "npm --workspace vanilla-press run build",
    "check": "vp fmt --check packages/vanilla-press/src packages/create-vanilla-press/bin packages/create-vanilla-press/src scripts && vp lint packages/vanilla-press/src && tsc --noEmit",
    "dev": "node packages/vanilla-press/bin/vanilla-press.js dev",
    "sync:create-template": "node scripts/sync-create-template.js",
    "test": "vp test run --dir packages/vanilla-press/src --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vanilla-press": "workspace:*",
    "vite-plus": "latest"
  }
}
